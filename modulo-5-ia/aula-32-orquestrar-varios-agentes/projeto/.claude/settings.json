{
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run python barato.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "mcp__kabum__coletas",
      "mcp__kabum__resumo_do_dia",
      "mcp__kabum__mais_baratos"
    ],
    "ask": [
      "Bash(uv add *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(uv run python coletar.py *)",
      "Bash(uv run python coletar.py)",
      "Bash(uv run python rodar.py *)",
      "Bash(uv run python rodar.py)",
      "Bash(uv run python fluxo.py *)",
      "Bash(uv run python fluxo.py)",
      "Bash(git push *)",
      "Bash(curl *)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          { "type": "command", "command": "uv", "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/barrar.py"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "uv", "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/testar.py"], "timeout": 120 }
        ]
      }
    ]
  }
}
