# O contato de verdade fica só no seu computador.
.env
# O que o programa baixa e gera. Fica fora do repositório, mas é o seu histórico: um dia apagado não volta.
dados/
# Os avisos de falha do fluxo.py. Ficam na sua máquina, como o log.
avisos.log
# Os logs em JSON de cada execução (logs/kabum.jsonl). Ficam na sua máquina: eles têm o que a loja respondeu.
logs/*
# A pasta existe no Git, vazia: o Collector a monta, e uma pasta que o Docker cria sozinho no Linux é do root.
!logs/.gitkeep
# O ambiente que o uv cria e os restos do Python.
.venv/
__pycache__/
.pytest_cache/
