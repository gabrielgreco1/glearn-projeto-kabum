{
  "uid": "kabum-dados",
  "title": "Kabum · dados",
  "tags": [
    "kabum"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "Esquema mudou",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(glearn_dado_esquema_hash{servico=\"kabum\"}[1m]) > 0",
        "step": "30s",
        "titleFormat": "A API mudou os campos",
        "textFormat": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Linhas do dia novo, e as de 7 dias antes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "description": "O volume do dia que acabou de ser publicado. A linha tracejada é o mesmo horário, sete dias antes: o mesmo dia da semana.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "glearn_dado_linhas{servico=\"kabum\"}",
          "legendFormat": "hoje"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "glearn_dado_linhas{servico=\"kabum\"} offset 7d",
          "legendFormat": "7 dias antes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "7 dias antes"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Vazios por coluna",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "description": "A fração de linhas do dia novo com a coluna vazia. preco_oferta é vazia em quem não está em oferta: o normal é alto, o que importa é o salto.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "glearn_dado_nulos_ratio{servico=\"kabum\"}",
          "legendFormat": "{{coluna}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Campos que a API mandou",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "description": "Quantos campos os produtos trouxeram. Um campo novo muda a impressão digital do esquema e vira uma anotação no painel.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "glearn_dado_campos{servico=\"kabum\"}",
          "legendFormat": "campos"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Dia mais novo no banco",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "description": "O dia mais novo da tabela precos, segundo a última medição.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "glearn_dado_dia_timestamp{servico=\"kabum\"} * 1000",
          "legendFormat": "dia"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Alertas de dado agora",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "description": "Os alertas de volume, vazios e esquema que estão disparando.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (alertname) (ALERTS{alertstate=\"firing\", alertname=~\"KabumVolumeCaiu|KabumVaziosSubiram|KabumEsquemaMudou\"})",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "nenhum",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    }
  ]
}
